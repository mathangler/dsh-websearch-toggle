{
  "name": "dsh-websearch-toggle",
  "version": "0.3.4",
  "description": "A live on/off switch for web_search in DeepSeek Harness, added to the official Web search card on the sidebar Plugins page without changing any official code.",
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./host-core": "./lib/host-core.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/host-core.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "web-search",
    "web_search",
    "toggle"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
